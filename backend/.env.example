# Varsha Setu Environment Configuration
HOST=0.0.0.0
PORT=8000
ARTIFACTS_DIR=artifacts

# Config-driven CORS: In production, specify exact deployed frontend domains (comma-separated or JSON list)
# Example: CORS_ORIGINS=["https://varsha-setu.lovable.app","https://my-domain.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000"]

# Timeouts (seconds)
OPEN_METEO_TIMEOUT_SECONDS=8.0
NOMINATIM_TIMEOUT_SECONDS=6.0
TELECONNECTIONS_TIMEOUT_SECONDS=6.0

# Geographic sanity distance cap: max km between OSM geocoded point and nearest verified Karnataka taluk
NOMINATIM_MAX_DISTANCE_KM=60.0

# In-Memory Caching TTLs (seconds) to protect external rate limits
TELECONNECTIONS_CACHE_TTL=86400
WEATHER_CACHE_TTL=600
LOCATION_CACHE_TTL=600
AUDIO_CACHE_TTL=86400

# Google Gemini API Key for Multilingual AI Assistant (optional; deterministic fallback active if omitted)
GEMINI_API_KEY=
